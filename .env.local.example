# ============================================================
# Build Saudi — Environment Variables
# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or expose a server secret as NEXT_PUBLIC_.
# ============================================================

# Public application URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://www.build.sa
# Optional compatibility alias; NEXT_PUBLIC_APP_URL takes precedence.
NEXT_PUBLIC_SITE_URL=https://www.build.sa
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Odoo Online — operational system of record
ODOO_BASE_URL=https://yourcompany.odoo.com
ODOO_DATABASE=yourdatabase
ODOO_USERNAME=api-user@example.com
ODOO_API_KEY=YOUR_ODOO_API_KEY
# Optional network tuning
# ODOO_REQUEST_TIMEOUT=15000
# ODOO_MAX_RETRIES=2

# Upstash Redis — REQUIRED in Production for distributed rate limiting and idempotency
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# Resend — outbound messages and inbound supplier RFQ replies
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Use the whsec_ value from the Resend inbound webhook configuration.
RESEND_INBOUND_WEBHOOK_SECRET=whsec_YOUR_RESEND_WEBHOOK_SECRET
ADMIN_EMAIL=admin@build.sa

# Cloudflare Turnstile — server verification plus public widget key
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Independent signing/authorization secrets. Generate a distinct long random value for each.
OTP_SECRET=YOUR_RANDOM_SECRET_1
UPLOAD_TOKEN_SECRET=YOUR_RANDOM_SECRET_2
VENDOR_ONBOARDING_TOKEN_SECRET=YOUR_RANDOM_SECRET_3
CRON_SECRET=YOUR_RANDOM_SECRET_4

# AI extraction for material requests and supplier RFQ replies.
# Configure only after privacy/processor approval; the service receives request/quote content.
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY

# Customer-facing fallback contact displayed by the quote page.
QUOTE_INTAKE_EMAIL=sales@build.sa

# Production notes
# 1. Configure Odoo custom models/fields and least-privilege service-account access before deployment.
# 2. Configure Resend inbound MX records and subscribe the webhook to email.received.
# 3. Production protected workflows fail closed without Upstash Redis.
# 4. Redeploy after changing environment variables and use PRODUCTION_CHECKLIST.md for proof.
